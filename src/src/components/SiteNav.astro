---
import { getMenu } from "emdash";

const menu = await getMenu("primary");
const menuItems = menu?.items?.length
	? menu.items
	: [
			{ label: "Home", url: "/" },
			{ label: "About", url: "/about" },
			{ label: "Programmes", url: "/programmes" },
			{ label: "Awards", url: "/awards" },
			{ label: "Gallery", url: "/gallery" },
		];

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
	href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<div class="nav-wrap" id="nav-wrap">
	<div class="nav-pill">
		<a href="/" aria-label="RAYLF home" style="flex:none">
			<img src="/logo/raylf-logo-white.png" alt="RAYLF" style="height:40px;width:auto" />
		</a>
		<nav class="nav-links">
			{
				menuItems.map((l: any) => (
					<a
						href={l.url}
						class:list={{ "nav-link": true, active: isActive(l.url) }}
					>
						{l.label}
					</a>
				))
			}
		</nav>
		<div style="margin-left:auto;display:flex;align-items:center;gap:12px">
			<button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">
				<i class="fa-solid fa-sun" />
			</button>
			<span class="nav-cta">
				<a class="btn btn-gold btn-sm" href="/awards#awardees">
					Awardees <i class="fa-solid fa-arrow-right" />
				</a>
			</span>
			<button class="nav-burger" id="nav-burger" aria-label="Menu">
				<i class="fa-solid fa-bars" />
			</button>
		</div>
		<nav class="nav-mobile" id="nav-mobile">
			{
				menuItems.map((l: any) => (
					<a href={l.url} class:list={{ "nav-link": true, active: isActive(l.url) }}>
						{l.label}
					</a>
				))
			}
		</nav>
	</div>
</div>

<script>
	function initNav() {
		const wrap = document.getElementById("nav-wrap");
		const toggle = document.getElementById("theme-toggle") as HTMLButtonElement | null;
		const burger = document.getElementById("nav-burger") as HTMLButtonElement | null;
		const mobile = document.getElementById("nav-mobile");

		const onScroll = () => wrap?.classList.toggle("scrolled", window.scrollY > 24);
		onScroll();
		window.addEventListener("scroll", onScroll, { passive: true });

		const setIcon = () => {
			if (!toggle) return;
			const theme = document.documentElement.getAttribute("data-theme");
			toggle.innerHTML =
				theme === "dark"
					? '<i class="fa-solid fa-sun"></i>'
					: '<i class="fa-solid fa-moon"></i>';
		};
		setIcon();

		toggle?.addEventListener("click", () => {
			const next =
				document.documentElement.getAttribute("data-theme") === "dark" ? "light" : "dark";
			document.documentElement.setAttribute("data-theme", next);
			try {
				localStorage.setItem("raylf-theme", next);
			} catch {}
			setIcon();
		});

		burger?.addEventListener("click", () => mobile?.classList.toggle("open"));
	}
	initNav();
	document.addEventListener("astro:page-load", initNav);
</script>
