---
import Base from "../../layouts/Base.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import AwardeeCard from "../../components/AwardeeCard.astro";
import { getEmDashCollection, getEmDashEntry } from "emdash";

const { slug } = Astro.params;
const { entry: a } = await getEmDashEntry("awardees", slug!, { status: "published" });

if (!a) {
	return Astro.rewrite("/404");
}

const { entries: all } = await getEmDashCollection("awardees", {
	status: "published",
	limit: 200,
});
const more = all.filter((x) => x.data.year === a.data.year && x.id !== a.id).slice(0, 4);

const momentPhotos = [
	"/photos/award-presentation-01.jpg",
	"/photos/award-presentation-02.jpg",
	"/photos/award-certificate-03.jpg",
];
---

<Base title={a.data.title} description={`${a.data.title} — RAYLF Awards ${a.data.year}`}>
	<!-- PROFILE HERO -->
	<section style="position:relative;background:#240145;color:#fff;padding:180px 0 96px;margin-top:-84px;overflow:hidden">
		<div class="grid-overlay" />
		<div class="container-raylf grid-2" style="gap:64px;position:relative">
			<div class="framed" style="position:relative;max-width:480px">
				<div
					class="portrait"
					style={`background-image:url(${a.data.photo_url});background-position:${a.data.photo_position || "center"}`}
				/>
				<div
					style="position:absolute;top:-24px;left:-24px;width:96px;height:96px;border-radius:50%;background:var(--gradient-gold);display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--violet-950);z-index:2"
				>
					<i class="fa-solid fa-award" style="font-size:24px" />
					<span style="font-family:var(--font-display);font-weight:700;font-size:12px;margin-top:2px">
						{a.data.year}
					</span>
				</div>
			</div>
			<div style="display:flex;flex-direction:column;gap:24px">
				<div class="breadcrumbs">
					<a href="/awards">RAYLF Awards</a>
					<i class="fa-solid fa-chevron-right" style="font-size:10px" />
					<a href={`/awards/${a.data.year}`}>{a.data.year}</a>
					<i class="fa-solid fa-chevron-right" style="font-size:10px" />
					<span class="current">{a.data.title}</span>
				</div>
				<Eyebrow tone="light">{a.data.category}</Eyebrow>
				<h1
					style="font-family:var(--font-display);font-weight:700;font-size:clamp(48px,7vw,104px);line-height:1.05;letter-spacing:-.04em;color:#fff"
				>
					{a.data.title}
				</h1>
				<div style="display:flex;flex-wrap:wrap;gap:24px;font-size:15px;color:rgba(255,255,255,.85)">
					<span style="display:inline-flex;align-items:center;gap:10px">
						<i class="fa-solid fa-location-dot" style="color:var(--gold-400)" />
						{a.data.country}
					</span>
					<span style="display:inline-flex;align-items:center;gap:10px">
						<i class="fa-solid fa-briefcase" style="color:var(--gold-400)" />
						{a.data.category} · Class of {a.data.year}
					</span>
				</div>
				<p style="max-width:560px;font-size:18px;line-height:1.7;color:rgba(255,255,255,.8)">
					{a.data.role}. Recognised at the {a.data.year} RAYLF Awards for
					outstanding achievement in {String(a.data.category).toLowerCase()} and an
					unwavering commitment to shaping, transforming and anchoring the future
					of the continent.
				</p>
				<div class="social-icons">
					<a href="#" aria-label="facebook"><i class="fa-brands fa-facebook-f" /></a>
					<a href="#" aria-label="x"><i class="fa-brands fa-x-twitter" /></a>
					<a href="#" aria-label="instagram"><i class="fa-brands fa-instagram" /></a>
				</div>
			</div>
		</div>
	</section>

	<!-- CITATION -->
	<section class="section-pad">
		<div style="max-width:1000px;margin:0 auto;padding:0 var(--container-pad);text-align:center">
			<Eyebrow>Award Citation</Eyebrow>
			<p
				style="margin-top:32px;font-family:var(--font-display);font-weight:500;font-size:clamp(26px,3vw,40px);line-height:1.35;letter-spacing:-.015em;color:var(--t-fg)"
			>
				&ldquo;{a.data.citation}&rdquo;
			</p>
			<div class="gold-rule" style="margin:32px auto" />
			<div style="font-size:14px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--t-gold)">
				Royal African Young Leadership Forum
			</div>
		</div>
	</section>

	<!-- MOMENTS -->
	<section style="padding:0 var(--container-pad) 140px">
		<div class="container-raylf flex-col gap-14">
			<div class="flex-col gap-5">
				<Eyebrow>Moments</Eyebrow>
				<h2 class="h-section">On the night.</h2>
			</div>
			<div
				style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:20px"
			>
				{
					momentPhotos.map((src) => (
						<div class="teaser-tile" style={`aspect-ratio:4/3;background-image:url(${src})`} />
					))
				}
			</div>
		</div>
	</section>

	<!-- MORE FROM THE CLASS -->
	{
		more.length > 0 && (
			<section class="section-pad" style="background:var(--t-sec)">
				<div class="container-raylf flex-col gap-14">
					<div class="flex-col gap-5">
						<Eyebrow>Class of {a.data.year}</Eyebrow>
						<h2 class="h-section">More from the class.</h2>
					</div>
					<div class="grid-awardees">
						{more.map((m) => (
							<AwardeeCard
								href={`/awardee/${m.id}`}
								photo={m.data.photo_url ?? ""}
								name={m.data.title}
								category={m.data.category ?? undefined}
								country={m.data.country ?? undefined}
								year={m.data.year ?? undefined}
								position={m.data.photo_position || null}
							/>
						))}
					</div>
				</div>
			</section>
		)
	}
</Base>
