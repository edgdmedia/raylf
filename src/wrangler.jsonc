{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "raylf",
	"account_id": "3a1a378bdf2b8bc66490838fe500dce4",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-10-02",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "raylf",
			"database_id": "a47b87a5-d4d9-411e-a7e5-f245f6fd063a"
		}
	],
	"triggers": {
		"crons": ["* * * * *"]
	}
}
