---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import AwardeeCard from "../../components/AwardeeCard.astro";
import { PortableText } from "emdash/ui";
import { getEmDashCollection, getEmDashEntry } from "emdash";

const { year } = Astro.params;
const { entry: ed } = await getEmDashEntry("editions", year!, { status: "published" });

if (!ed) {
	return Astro.rewrite("/404");
}

const { entries: awardees } = await getEmDashCollection("awardees", {
	status: "published",
	limit: 200,
	where: { year: ed.data.year },
});
---

<Base title={`${ed.data.year} Edition`} description={ed.data.intro ?? undefined}>
	<PageHero
		image={ed.data.image_url ?? undefined}
		crumbs={[
			{ label: "Home", href: "/" },
			{ label: "RAYLF Awards", href: "/awards" },
			{ label: ed.data.year },
		]}
		title={ed.data.title}
		goldWord={ed.data.year}
		intro={ed.data.tag ?? undefined}
		height="72vh"
	/>

	<!-- OVERVIEW + DETAILS -->
	<section class="section-pad">
		<div class="container-raylf" style="display:grid;grid-template-columns:1.6fr minmax(280px,1fr);gap:56px">
			<div style="display:flex;flex-direction:column;gap:28px">
				<Eyebrow>The Edition</Eyebrow>
				<h2 class="h-section" style="font-size:clamp(36px,4.5vw,60px);line-height:1.12">
					{ed.data.year} — {ed.data.location}.
				</h2>
				<div class="muted" style="font-size:18px;line-height:1.7">
					<PortableText value={ed.data.summary} />
				</div>
			</div>
			<aside style="position:sticky;top:120px;align-self:start">
				<div class="details-card">
					{
						[
							{ k: "Edition", v: ed.data.tag },
							{ k: "Host", v: ed.data.location },
							{ k: "Venue", v: ed.data.venue },
							{ k: "Date", v: ed.data.date },
						].map((d) => (
							<div class="detail-row">
								<div class="k">{d.k}</div>
								<div class="v">{d.v}</div>
							</div>
						))
					}
					<a class="btn btn-gold btn-md" href="/awards">All editions <i class="fa-solid fa-arrow-right" /></a>
				</div>
			</aside>
		</div>
	</section>

	<!-- STATS -->
	<section style="padding:0 var(--container-pad) 140px">
		<div class="container-raylf">
			<div
				style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;background:var(--t-line);border-radius:var(--radius-md);overflow:hidden"
			>
				{
					(ed.data.stats ?? []).map((s: any) => (
						<div style="background:var(--t-bg);padding:32px;display:flex;flex-direction:column;gap:6px">
							<div
								style="font-family:var(--font-display);font-weight:700;font-size:clamp(34px,4vw,56px);letter-spacing:-.03em;color:var(--t-gold)"
							>
								{s.v}
							</div>
							<div class="muted" style="font-size:14px">{s.l}</div>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- TEAM -->
	<section class="section-pad" style="background:var(--t-sec)">
		<div class="container-raylf flex-col gap-14">
			<div class="flex-col gap-5">
				<Eyebrow>Committee &amp; Patronage</Eyebrow>
				<h2 class="h-section">The {ed.data.year} team.</h2>
			</div>
			<div
				style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:24px"
			>
				{
					(ed.data.team ?? []).map((t: any) => (
						<div
							style="background:var(--t-card);border:1px solid var(--t-line);border-radius:var(--radius-lg);padding:32px;display:flex;flex-direction:column;gap:12px"
						>
							<div style="font-size:12px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--t-gold)">
								{t.role}
							</div>
							<div style="font-family:var(--font-display);font-weight:600;font-size:18px;line-height:1.4;color:var(--t-fg)">
								{t.name}
							</div>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- AWARDEES -->
	<section class="section-pad">
		<div class="container-raylf flex-col gap-14">
			<div class="flex-col gap-5">
				<Eyebrow>Awardees</Eyebrow>
				<h2 class="h-section">Class of {ed.data.year}.</h2>
			</div>
			{
				awardees.length === 0 ? (
					<p class="muted" style="font-size:18px;max-width:560px">
						Awardees for this edition will be announced here.
					</p>
				) : (
					<div class="grid-awardees">
						{awardees.map((a) => (
							<AwardeeCard
								href={`/awardee/${a.id}`}
								photo={a.data.photo_url ?? ""}
								name={a.data.title}
								category={a.data.category ?? undefined}
								country={a.data.country ?? undefined}
								year={a.data.year ?? undefined}
								position={a.data.photo_position || null}
							/>
						))}
					</div>
				)
			}
		</div>
	</section>
</Base>
