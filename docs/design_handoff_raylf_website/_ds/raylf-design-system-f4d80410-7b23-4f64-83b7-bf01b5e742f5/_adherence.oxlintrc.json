{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/core/**",
              "components/navigation/**",
              "components/social/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Poppins|Manrope))/i]",
        "message": "Font not provided by the design system. Available: Poppins, Manrope."
      },
      {
        "selector": "JSXOpeningElement[name.name='AwardeeCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:photo|name|category|year|country|key|ref|className|style|children)$/]",
        "message": "<AwardeeCard> doesn't accept that prop. Declared props: photo, name, category, year, country."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconRight|disabled|href|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconRight, disabled, href, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|gold|outline|outline-light|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'gold' | 'outline' | 'outline-light' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:gold|light|purple|white)$/]",
        "message": "<Eyebrow> tone must be one of 'gold' | 'light' | 'purple' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|eyebrow|title|children|cta|href|tone|key|ref|className|style|children)$/]",
        "message": "<FeatureCard> doesn't accept that prop. Declared props: image, eyebrow, title, children, cta, href, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<FeatureCard> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hero'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|eyebrow|title|children|actions|minHeight|align|key|ref|className|style|children)$/]",
        "message": "<Hero> doesn't accept that prop. Declared props: image, eyebrow, title, children, actions, minHeight, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hero'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<Hero> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PartnerStrip'] > JSXAttribute > JSXIdentifier[name!=/^(?:logos|height|key|ref|className|style|children)$/]",
        "message": "<PartnerStrip> doesn't accept that prop. Declared props: logos, height."
      },
      {
        "selector": "JSXOpeningElement[name.name='RoyalQuote'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|attribution|tone|size|key|ref|className|style|children)$/]",
        "message": "<RoyalQuote> doesn't accept that prop. Declared props: children, attribution, tone, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='RoyalQuote'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<RoyalQuote> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RoyalQuote'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<RoyalQuote> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|align|tone|rule|level|children|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: eyebrow, title, align, tone, rule, level, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|left)$/]",
        "message": "<SectionHeading> align must be one of 'center' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<SectionHeading> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:logo|mission|links|email|key|ref|className|style|children)$/]",
        "message": "<SiteFooter> doesn't accept that prop. Declared props: logo, mission, links, email."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:logo|links|active|onNavigate|tone|key|ref|className|style|children)$/]",
        "message": "<SiteHeader> doesn't accept that prop. Declared props: logo, links, active, onNavigate, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteHeader'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<SiteHeader> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SocialLinks'] > JSXAttribute > JSXIdentifier[name!=/^(?:networks|tone|variant|handle|site|key|ref|className|style|children)$/]",
        "message": "<SocialLinks> doesn't accept that prop. Declared props: networks, tone, variant, handle, site."
      },
      {
        "selector": "JSXOpeningElement[name.name='SocialLinks'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<SocialLinks> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SocialLinks'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:icons|pill)$/]",
        "message": "<SocialLinks> variant must be one of 'icons' | 'pill'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SocialPost'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|width|headline|body|highlight|image|logo|networks|handle|site|showPill|key|ref|className|style|children)$/]",
        "message": "<SocialPost> doesn't accept that prop. Declared props: variant, width, headline, body, highlight, image, logo, networks, handle, site, showPill."
      },
      {
        "selector": "JSXOpeningElement[name.name='SocialPost'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:greeting|festive|photo)$/]",
        "message": "<SocialPost> variant must be one of 'greeting' | 'festive' | 'photo'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
