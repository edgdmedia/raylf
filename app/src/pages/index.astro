---
import Base from "../layouts/Base.astro";
import Eyebrow from "../components/Eyebrow.astro";
import AwardeeCard from "../components/AwardeeCard.astro";
import { programmes, editions } from "../data";

const marqueeWords = [
	"Shaping",
	"Transforming",
	"Anchoring",
	"Young Leaders",
	"20 to 39",
	"RAYLF Awards",
	"G2G Millionaires",
];
const marqueeRow = [...marqueeWords, ...marqueeWords, ...marqueeWords, ...marqueeWords];

const facts = [
	{ v: "512", l: "Leaders recognised across four editions" },
	{ v: "4", l: "Award editions since 2020" },
	{ v: "51st", l: "Ooni of Ife, Royal Patron" },
];

const heroImages = [
	"/photos/award-stage-01.jpg",
	"/photos/award-presentation-04.jpg",
	"/photos/award-presentation-01.jpg",
];

const galleryTeaser = [
	"/photos/award-presentation-04.jpg",
	"/photos/speaker-portrait.jpg",
	"/photos/award-greeting.jpg",
];

const sortedEditions = [...editions].sort((a, b) =>
	b.data.year.localeCompare(a.data.year)
);
---

<Base>
	<!-- HERO -->
	<section class="hero">
		<div id="hero-slides">
			{
				heroImages.map((src, i) => (
					<div
						class:list={{ "hero-bg": true, kenburns: true, "hero-slide": true }}
						data-slide={i}
						style={`background-image:url(${src});opacity:${i === 0 ? 1 : 0}`}
					/>
				))
			}
		</div>
		<div class="hero-scrim" />
		<div class="hero-glow" />
		<div class="grid-overlay" />
		<div
			class="pulse-ring"
			style="position:absolute;right:8%;top:18%;width:360px;height:360px;border-radius:50%;border:1px solid rgba(255,243,168,.3);box-shadow:inset 0 0 80px rgba(180,73,220,.35), 0 0 120px rgba(180,73,220,.3);pointer-events:none;animation:raylf-pulse 6s ease-in-out infinite"
		/>
		<div class="container-raylf hero-inner">
			<div class="pill-label">
				<span class="pill-dot" />
				Royal African Young Leadership Forum
			</div>
			<h1 class="h-display" style="font-size:clamp(52px,10vw,148px);max-width:1200px">
				A place for Africa&rsquo;s <span class="gold-foil">young leaders.</span>
			</h1>
			<div class="hero-bottom">
				<p style="max-width:520px;font-size:19px;line-height:1.6;color:rgba(255,255,255,.82)">
					RAYLF recognises and convenes the most outstanding 20 to 39-year olds
					across the globe, shaping, transforming and anchoring the future of the
					continent.
				</p>
				<div class="hero-actions">
					<a class="btn btn-gold btn-lg" href="/awards">RAYLF Awards <i class="fa-solid fa-arrow-right" /></a>
					<a class="btn btn-outline-light btn-lg" href="/about">About RAYLF</a>
				</div>
			</div>
		</div>
	</section>

	<!-- MARQUEE -->
	<div class="marquee-band">
		<div class="marquee-track">
			{
				marqueeRow.map(
					(w, i) => (
						<span class:list={{ "marquee-word": true, gold: i % 2 === 0 }}>
							{w} <i class="fa-solid fa-star" />
						</span>
					)
				)
			}
		</div>
	</div>

	<!-- ABOUT -->
	<section class="section-pad">
		<div class="container-raylf grid-2">
			<div class="framed">
				<div class="portrait" style="background-image:url(/photos/his-majesty-throne.jpg)" />
				<div class="patron-card">
					<div style="font-size:11px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:#fff3a8;margin-bottom:6px">
						Royal Patron
					</div>
					<div style="font-family:var(--font-display);font-weight:600;font-size:16px;line-height:1.35">
						His Imperial Majesty Oba Adeyeye Enitan Ogunwusi, Ojaja II
					</div>
				</div>
			</div>
			<div class="flex-col gap-7">
				<Eyebrow>About RAYLF</Eyebrow>
				<h2 class="h-section">The spirit, soul and memory of Africa.</h2>
				<p class="muted" style="font-size:18px;line-height:1.7">
					RAYLF is a programme of the Royal African Foundation of His Imperial
					Majesty, the 51st Ooni of Ife. It exists to redefine centuries of the
					rich resilient spirit of African Kingdoms, which embodies many defining
					principles of its identity.
				</p>
				<p class="muted" style="font-size:18px;line-height:1.7">
					Through the RAYLF Awards and programmes such as G2G Millionaires, we
					celebrate the success stories of young leaders and connect them to a
					lineage of royal patronage.
				</p>
				<div class="stats-strip" style="margin-top:12px">
					{
						facts.map((f) => (
							<div class="stat-cell">
								<div class="stat-num">{f.v}</div>
								<div class="stat-label">{f.l}</div>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</section>

	<!-- PROGRAMMES -->
	<section class="section-pad" style="background:var(--t-sec)">
		<div class="container-raylf flex-col gap-14">
			<div style="display:flex;justify-content:space-between;align-items:flex-end;gap:32px;flex-wrap:wrap">
				<div class="flex-col gap-5" style="max-width:720px">
					<Eyebrow>What We Do</Eyebrow>
					<h2 class="h-section">Find your place.</h2>
				</div>
				<p class="muted" style="max-width:400px;font-size:17px">
					Three ways RAYLF recognises, equips and connects young African leaders.
				</p>
			</div>
			<div class="grid-cards">
				{
					programmes.map((p) => (
						<a href={p.data.link ?? `/programmes/${p.id}`} class="programme-card card-lift">
							<div class="hero-bg" style={`background-image:url(${p.data.image_url})`} />
							<div
								style="position:absolute;inset:0;background:linear-gradient(180deg, rgba(36,1,69,.2) 0%, rgba(36,1,69,.55) 45%, rgba(36,1,69,.96) 100%)"
							/>
							<div class="card-top">
								<span class="card-num">{p.data.number}</span>
								<span class="card-arrow">
									<i class="fa-solid fa-arrow-right" style="transform:rotate(-45deg)" />
								</span>
							</div>
							<div class="card-bottom">
								<h3>{p.data.title}</h3>
								<p style="font-size:15px;line-height:1.6;color:rgba(255,255,255,.8)">{p.data.excerpt}</p>
							</div>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<!-- QUOTE -->
	<section class="quote-band">
		<div class="hero-bg" style="background-image:url(/photos/royal-audience.jpg)" />
		<div style="position:absolute;inset:0;background:rgba(36,1,69,.88)" />
		<div class="quote-ring" style="width:720px;height:720px;border:1px solid rgba(255,243,168,.14)" />
		<div class="quote-ring" style="width:1040px;height:1040px;border:1px solid rgba(255,243,168,.08)" />
		<div class="quote-inner">
			<i class="fa-solid fa-quote-left" style="font-size:40px;color:#f2b84b" />
			<blockquote>Young Africans are the spirit, soul and memory of Africa.</blockquote>
			<div class="gold-rule" />
			<div style="font-size:14px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:#fff3a8">
				His Imperial Majesty (H.I.M) Ooni of Ife
			</div>
		</div>
	</section>

	<!-- AWARDS -->
	<section class="section-pad">
		<div class="container-raylf flex-col gap-14" style="gap:64px">
			<div style="display:flex;justify-content:space-between;align-items:flex-end;gap:32px;flex-wrap:wrap">
				<div class="flex-col gap-5" style="max-width:760px">
					<Eyebrow>RAYLF Awards</Eyebrow>
					<h2 class="h-section">Every edition, a new generation.</h2>
				</div>
				<a class="btn btn-outline btn-md" href="/awards#awardees">Awardees <i class="fa-solid fa-arrow-right" /></a>
			</div>
			<div class="flex-col gap-5">
				<div class="edition-rail" id="edition-rail">
					{
						sortedEditions.map((e) => (
							<a href={`/awards/${e.data.year}`} class="edition-tile card-lift">
								<div class="hero-bg" style={`background-image:url(${e.data.image_url})`} />
								<div style="position:absolute;inset:0;background:var(--overlay-scrim)" />
								<span class="edition-tag">{e.data.tag}</span>
								<div class="edition-year">
									{e.data.year}
									<div class="edition-label">
										{e.data.upcoming ? e.data.location : "RAYLF Awards"}
									</div>
								</div>
							</a>
						))
					}
				</div>
				<div class="rail-controls">
					<button type="button" class="rail-btn" id="rail-prev" aria-label="Scroll editions left" disabled>
						<i class="fa-solid fa-chevron-left" />
					</button>
					<button type="button" class="rail-btn" id="rail-next" aria-label="Scroll editions right">
						<i class="fa-solid fa-chevron-right" />
					</button>
				</div>
			</div>
		</div>
	</section>

	<!-- GALLERY TEASER -->
	<section style="padding:0 var(--container-pad) 140px">
		<div class="container-raylf teaser-grid">
			<div class="teaser-tile big" style={`background-image:url(${galleryTeaser[0]})`} />
			<div class="teaser-tile" style={`background-image:url(${galleryTeaser[1]})`} />
			<div class="teaser-tile" style={`background-image:url(${galleryTeaser[2]})`} />
			<div class="follow-card wide">
				<div class="hero-bg" style="background-image:url(/photos/award-greeting.jpg)" />
				<div
					style="position:absolute;inset:0;background:linear-gradient(100deg, rgba(63,2,142,.92) 0%, rgba(80,2,185,.8) 45%, rgba(180,73,220,.65) 100%)"
				/>
				<div class="follow-content">
					<div style="font-size:12px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:#fff3a8">
						Follow the journey
					</div>
					<div style="display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap">
						<div style="font-family:var(--font-display);font-weight:700;font-size:32px;letter-spacing:-.02em">
							@royalafricanlyf
						</div>
						<div class="social-icons">
							<a href="#" aria-label="facebook"><i class="fa-brands fa-facebook-f" /></a>
							<a href="#" aria-label="x"><i class="fa-brands fa-x-twitter" /></a>
							<a href="#" aria-label="instagram"><i class="fa-brands fa-instagram" /></a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- GLOBAL MISSION -->
	<section style="position:relative;background:#240145;padding:140px 0">
		<div class="hero-bg" style="background-image:url(/brand/africa-world-map.jpg);opacity:.5" />
		<div
			class="hero-bg"
			style="background:linear-gradient(90deg, #240145 0%, rgba(36,1,69,.75) 55%, rgba(36,1,69,.35) 100%)"
		/>
		<div class="container-raylf flex-col gap-6" style="position:relative">
			<Eyebrow tone="light">Global Mission</Eyebrow>
			<h2 class="h-section" style="color:#fff;max-width:760px">From Ile-Ife to the world.</h2>
			<p style="max-width:560px;font-size:18px;line-height:1.7;color:rgba(255,255,255,.8)">
				Africa&rsquo;s economic prosperity, the blessings of its natural resources
				and the valuable inheritance of its creative culture, carried forward by
				young leaders across every continent.
			</p>
		</div>
	</section>

	<!-- CTA -->
	<section class="section-pad">
		<div class="container-raylf">
			<div class="cta-panel">
				<div class="cta-glow" />
				<div class="flex-col text-center" style="position:relative;align-items:center;gap:28px;max-width:940px;margin:0 auto">
					<h2
						style="font-family:var(--font-display);font-weight:700;font-size:clamp(40px,6vw,88px);line-height:1.05;letter-spacing:-.04em;color:#fff;max-width:900px"
					>
						There&rsquo;s a place for you.
					</h2>
					<p style="max-width:560px;font-size:18px;line-height:1.65;color:rgba(255,255,255,.88)">
						Discover the programmes through which RAYLF recognises, equips and
						connects young African leaders.
					</p>
					<div style="display:flex;gap:14px;flex-wrap:wrap;justify-content:center">
						<a class="btn btn-gold btn-lg" href="/programmes">Our Programmes <i class="fa-solid fa-arrow-right" /></a>
						<a class="btn btn-outline-light btn-lg" href="/about">About RAYLF</a>
					</div>
				</div>
			</div>
		</div>
	</section>
</Base>

<script>
	const slides = [...document.querySelectorAll("#hero-slides .hero-slide")] as HTMLElement[];
	if (slides.length > 1) {
		let i = 0;
		setInterval(() => {
			slides[i].style.opacity = "0";
			i = (i + 1) % slides.length;
			slides[i].style.opacity = "1";
		}, 7000);
	}

	const rail = document.getElementById("edition-rail");
	const prev = document.getElementById("rail-prev") as HTMLButtonElement | null;
	const next = document.getElementById("rail-next") as HTMLButtonElement | null;
	if (rail && prev && next) {
		const update = () => {
			prev.disabled = rail.scrollLeft <= 4;
			next.disabled = rail.scrollLeft + rail.clientWidth >= rail.scrollWidth - 4;
		};
		const step = () => (rail.firstElementChild as HTMLElement)?.offsetWidth ?? 300;
		prev.addEventListener("click", () => rail.scrollBy({ left: -(step() + 20), behavior: "smooth" }));
		next.addEventListener("click", () => rail.scrollBy({ left: step() + 20, behavior: "smooth" }));
		rail.addEventListener("scroll", update, { passive: true });
		window.addEventListener("resize", update);
		update();
	}
</script>

<style>
	@keyframes raylf-pulse {
		0%,
		100% {
			opacity: 0.55;
			transform: scale(1);
		}
		50% {
			opacity: 0.9;
			transform: scale(1.06);
		}
	}
</style>
