---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found">
	<main class="section-pad">
		<div class="container-raylf text-center flex-col" style="align-items:center;gap:24px">
			<div style="font-family:var(--font-display);font-weight:700;font-size:clamp(80px,14vw,180px);line-height:1" class="gold-foil">
				404
			</div>
			<h1 class="h-section">This page has wandered off.</h1>
			<p class="muted" style="max-width:480px;font-size:18px">
				The page you're looking for doesn't exist or has moved.
			</p>
			<a class="btn btn-gold btn-md" href="/">Back home <i class="fa-solid fa-arrow-right" /></a>
		</div>
	</main>
</Base>
