---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import PortableText from "../../components/PortableText.astro";
import { programmes } from "../../data";

export function getStaticPaths() {
	return programmes.map((p) => ({ params: { slug: p.id }, props: { programme: p } }));
}

const { programme } = Astro.props as { programme: (typeof programmes)[number] };
const others = programmes.filter((p) => p.id !== programme.id);
---

<Base title={programme.data.title} description={programme.data.excerpt ?? undefined}>
	<PageHero
		image={programme.data.image_url ?? undefined}
		crumbs={[
			{ label: "Home", href: "/" },
			{ label: "Programmes", href: "/programmes" },
			{ label: programme.data.title },
		]}
		title={programme.data.title.split(" ")[0]}
		goldWord={programme.data.title.split(" ").slice(1).join(" ")}
		height="80vh"
		scrim="left"
	/>

	<!-- OVERVIEW + DETAILS -->
	<section class="section-pad">
		<div
			class="container-raylf"
			style="display:grid;grid-template-columns:1.6fr minmax(280px,1fr);gap:56px"
		>
			<div style="display:flex;flex-direction:column;gap:28px">
				<Eyebrow>The Programme</Eyebrow>
				<h2 class="h-section" style="font-size:clamp(36px,4.5vw,60px);line-height:1.12">
					{programme.data.title}
				</h2>
				<div class="muted" style="font-size:18px;line-height:1.7">
					<PortableText value={programme.data.overview} />
				</div>
			</div>
			<aside style="position:sticky;top:120px;align-self:start">
				<div class="details-card">
					{
						(programme.data.details ?? []).map((d: any) => (
							<div class="detail-row">
								<div class="k">{d.key}</div>
								<div class="v">{d.value}</div>
							</div>
						))
					}
					<a class="btn btn-gold btn-md" href="mailto:info@royalafrican.foundation">
						Enquire <i class="fa-solid fa-arrow-right" />
					</a>
				</div>
			</aside>
		</div>
	</section>

	<!-- OFFERS -->
	{
		(programme.data.offers ?? []).length > 0 && (
			<section class="section-pad" style="background:var(--t-sec)">
				<div class="container-raylf flex-col gap-14">
					<div class="flex-col gap-5" style="max-width:720px">
						<Eyebrow>What the programme offers</Eyebrow>
						<h2 class="h-section">Built for builders.</h2>
					</div>
					<div
						style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:24px"
					>
						{programme.data.offers.map((o: any) => (
							<div
								style="background:var(--t-card);border:1px solid var(--t-line);border-radius:var(--radius-lg);padding:32px;display:flex;flex-direction:column;gap:20px"
							>
								<span
									style="width:52px;height:52px;border-radius:50%;background:var(--gradient-gold);display:flex;align-items:center;justify-content:center;color:var(--violet-950);font-size:20px"
								>
									<i class={o.icon} />
								</span>
								<h3 style="font-size:22px;letter-spacing:-.02em;color:var(--t-fg)">{o.title}</h3>
								<p class="muted" style="font-size:15px;line-height:1.65">{o.body}</p>
							</div>
						))}
					</div>
				</div>
			</section>
		)
	}

	<!-- MOMENTS -->
	{
		(programme.data.moments ?? []).length > 0 && (
			<section class="section-pad">
				<div class="container-raylf flex-col gap-14">
					<div class="flex-col gap-5">
						<Eyebrow>Moments</Eyebrow>
						<h2 class="h-section">From the journey.</h2>
					</div>
					<div
						style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));grid-auto-rows:280px;gap:20px"
					>
						{programme.data.moments.map((m: any) => (
							<div class="teaser-tile" style={`background-image:url(${m.image_url})`} />
						))}
					</div>
				</div>
			</section>
		)
	}

	<!-- OTHER PROGRAMMES -->
	<section style="padding:0 var(--container-pad) 140px">
		<div class="container-raylf grid-cards">
			{
				others.map((p) => (
					<a href={p.data.link ?? `/programmes/${p.id}`} class="programme-card card-lift" style="min-height:380px">
						<div class="hero-bg" style={`background-image:url(${p.data.image_url})`} />
						<div
							style="position:absolute;inset:0;background:linear-gradient(180deg, rgba(36,1,69,.15) 0%, rgba(36,1,69,.92) 100%)"
						/>
						<div class="card-top" style="justify-content:flex-end">
							<span
								style="width:48px;height:48px;border-radius:50%;background:var(--gold-200);color:var(--violet-950);display:flex;align-items:center;justify-content:center"
							>
								<i class="fa-solid fa-arrow-right" style="transform:rotate(-45deg)" />
							</span>
						</div>
						<div class="card-bottom">
							<h3 style="font-size:28px">{p.data.title}</h3>
							<p style="font-size:15px;line-height:1.6;color:rgba(255,255,255,.8)">{p.data.excerpt}</p>
						</div>
					</a>
				))
			}
		</div>
	</section>
</Base>
