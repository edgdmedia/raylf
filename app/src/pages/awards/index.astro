---
import Base from "../../layouts/Base.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import RoyalQuote from "../../components/RoyalQuote.astro";
import AwardeeCard from "../../components/AwardeeCard.astro";
import { editions, awardees } from "../../data";

const sorted = [...editions].sort((a, b) => b.data.year.localeCompare(a.data.year));

const categories = ["All", "Entrepreneurship", "Public Service", "Creative Arts", "Technology", "Philanthropy"];
---

<Base title="RAYLF Awards">
	<main>
		<!-- HERO -->
		<section class="page-hero" style="min-height:86vh">
			{
				sorted.map((e, i) => (
					<div
						class:list={{ "hero-bg": true, "hero-slide": true }}
						data-edition-slide={e.data.year}
						style={`background-image:url(${e.data.image_url});opacity:${i === 1 ? 1 : 0}`}
					/>
				))
			}
			<div
				style="position:absolute;inset:0;background:linear-gradient(180deg, rgba(36,1,69,.55) 0%, rgba(36,1,69,.4) 40%, rgba(36,1,69,.95) 85%, #240145 100%)"
			/>
			<div
				style="position:absolute;inset:0;background:radial-gradient(50% 50% at 80% 30%, rgba(180,73,220,.4) 0%, rgba(180,73,220,0) 70%)"
			/>
			<div class="grid-overlay" />
			<div class="container-raylf page-hero-inner">
				<div class="breadcrumbs">
					<a href="/">Home</a>
					<i class="fa-solid fa-chevron-right" style="font-size:10px" />
					<span class="current">RAYLF Awards</span>
				</div>
				<div style="display:flex;justify-content:space-between;align-items:flex-end;gap:32px;flex-wrap:wrap">
					<h1 class="h-display">
						RAYLF Awards <span class="gold-foil" id="awards-year">2024</span>
					</h1>
					<span
						id="awards-tag"
						style="padding:8px 16px;border-radius:var(--radius-pill);border:1px solid rgba(255,243,168,.35);font-size:13px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#fff3a8"
					/>
				</div>
				<p id="awards-intro" style="max-width:640px;font-size:19px;line-height:1.6;color:rgba(255,255,255,.85)" />
				<div
					style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;border-top:1px solid rgba(255,255,255,.16);padding-top:24px"
				>
					{
						sorted.map((e, i) => (
							<button
								class:list={{ "year-tab": true, active: e.data.year === "2024" }}
								data-year={e.data.year}
							>
								{e.data.year}
							</button>
						))
					}
					<a
						id="edition-link"
						href="/awards/2024"
						style="margin-left:auto;display:inline-flex;align-items:center;gap:8px;padding:10px 20px;border-radius:var(--radius-pill);font-family:var(--font-display);font-weight:600;font-size:14px;color:#fff3a8"
					>
						Edition details <i class="fa-solid fa-arrow-right" style="font-size:12px" />
					</a>
				</div>
			</div>
		</section>

		<!-- AWARDEES -->
		<section id="awardees" class="section-pad">
			<div class="container-raylf flex-col gap-10">
				<div style="display:flex;justify-content:space-between;align-items:flex-end;gap:32px;flex-wrap:wrap">
					<div class="flex-col gap-5">
						<Eyebrow>Awardees</Eyebrow>
						<h2 class="h-section">Class of <span id="class-year">2024</span></h2>
					</div>
					<div id="cat-chips" style="display:flex;gap:8px;flex-wrap:wrap">
						{
							categories.map((c) => (
								<button class:list={{ chip: true, active: c === "All" }} data-cat={c}>
									{c}
								</button>
							))
						}
					</div>
				</div>

				<div id="awardees-empty" class="details-card" style="display:none;align-items:center;text-align:center">
					<i class="fa-solid fa-hourglass-half" style="font-size:32px;color:var(--t-gold)" />
					<h3 style="font-size:24px;color:var(--t-fg)">Awardees to be announced</h3>
					<p class="muted" style="max-width:480px">
						The 2026 edition happens in Ghana this year. Awardees will be revealed
						ahead of the ceremony — follow @royalafricanlyf for announcements.
					</p>
					<a class="btn btn-gold btn-md" href="/awards/2026">About the 2026 edition <i class="fa-solid fa-arrow-right" /></a>
				</div>

				<div id="awardees-grid" class="grid-awardees">
					{
						awardees.map((a) => (
							<div
								class="awardee-cell"
								data-year={a.data.year}
								data-category={a.data.category}
								style="display:none"
							>
								<AwardeeCard
									href={`/awardee/${a.id}`}
									photo={a.data.photo_url ?? ""}
									name={a.data.title}
									category={a.data.category ?? undefined}
									country={a.data.country ?? undefined}
									year={a.data.year ?? undefined}
									position={a.data.photo_position || null}
								/>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- CEREMONY -->
		<section style="padding:140px 0;background:#240145;color:#fff">
			<div
				class="container-raylf"
				style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:72px;align-items:center"
			>
				<div class="flex-col gap-7">
					<Eyebrow tone="light">The Ceremony</Eyebrow>
					<h2
						style="font-family:var(--font-display);font-weight:700;font-size:clamp(34px,4.5vw,60px);line-height:1.1;letter-spacing:-.03em;color:#fff"
					>
						Presented under royal patronage.
					</h2>
					<RoyalQuote tone="dark" size="lg" attribution="His Imperial Majesty (H.I.M) Ooni of Ife">
						Young Africans are the spirit, soul and memory of Africa.
					</RoyalQuote>
					<div>
						<a class="btn btn-outline-light btn-md" href="/gallery">Gallery <i class="fa-solid fa-arrow-right" /></a>
					</div>
				</div>
				<div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));grid-auto-rows:220px;gap:16px">
					<div class="teaser-tile" style="grid-row:span 2;background-image:url(/photos/award-certificate-01.jpg)" />
					<div class="teaser-tile" style="background-image:url(/photos/award-presentation-04.jpg)" />
					<div class="teaser-tile" style="background-image:url(/photos/award-certificate-02.jpg)" />
				</div>
			</div>
		</section>
	</main>
</Base>

<script>
	const yearTabs = [...document.querySelectorAll<HTMLElement>("[data-year].year-tab")];
	const chips = [...document.querySelectorAll<HTMLElement>("[data-cat]")];
	const cells = [...document.querySelectorAll<HTMLElement>(".awardee-cell")];
	const slides = [...document.querySelectorAll<HTMLElement>("[data-edition-slide]")];
	const yearLabel = document.getElementById("awards-year");
	const tagLabel = document.getElementById("awards-tag");
	const introLabel = document.getElementById("awards-intro");
	const classYear = document.getElementById("class-year");
	const editionLink = document.getElementById("edition-link");
	const grid = document.getElementById("awardees-grid");
	const empty = document.getElementById("awardees-empty");
	const chipsWrap = document.getElementById("cat-chips");

	const editionData = JSON.parse(document.getElementById("edition-data")?.textContent ?? "{}");

	let year = "2024";
	let cat = "All";

	function render() {
		yearTabs.forEach((t) => t.classList.toggle("active", t.dataset.year === year));
		chips.forEach((c) => c.classList.toggle("active", c.dataset.cat === cat));
		slides.forEach((s) => (s.style.opacity = s.dataset.editionSlide === year ? "1" : "0"));

		const ed = editionData[year] ?? {};
		if (yearLabel) yearLabel.textContent = year;
		if (classYear) classYear.textContent = year;
		if (tagLabel) tagLabel.textContent = ed.tag ?? "";
		if (introLabel) introLabel.textContent = ed.intro ?? "";
		if (editionLink) editionLink.setAttribute("href", `/awards/${year}`);

		const yearCells = cells.filter((c) => c.dataset.year === year);
		const hasAwardees = yearCells.length > 0;
		if (grid) grid.style.display = hasAwardees ? "" : "none";
		if (empty) empty.style.display = hasAwardees ? "none" : "flex";
		if (chipsWrap) chipsWrap.style.display = hasAwardees ? "flex" : "none";

		cells.forEach((c) => {
			const show = c.dataset.year === year && (cat === "All" || c.dataset.category === cat);
			c.style.display = show ? "" : "none";
		});
	}

	yearTabs.forEach((t) =>
		t.addEventListener("click", () => {
			year = t.dataset.year!;
			cat = "All";
			render();
		})
	);
	chips.forEach((c) =>
		c.addEventListener("click", () => {
			cat = c.dataset.cat!;
			render();
		})
	);

	render();
</script>

<script type="application/json" id="edition-data" set:html={JSON.stringify(Object.fromEntries(sorted.map((e) => [e.data.year, { tag: e.data.tag, intro: e.data.intro }])))} />
