---
import { placeholderImage } from "../lib/awardee-image";

interface Props {
	photo: string | null;
	name: string;
	category?: string;
	year?: string;
	country?: string;
	position?: string | null;
	href: string;
}
const { photo, name, category, year, country, position, href } = Astro.props;
const image = photo || placeholderImage(name);
---

<a href={href} class="awardee-link card-lift" style="display:block">
	<figure class="awardee-card" style={`background-image:url(${image});background-position:${photo ? position || "center" : "center"}`}>
		<div class="scrim" />
		<figcaption>
			{category && <div class="cat">{category}</div>}
			<div class="name">{name}</div>
			{(year || country) && <div class="meta">{[country, year].filter(Boolean).join(" · ")}</div>}
		</figcaption>
		<div class="topline" />
	</figure>
</a>
