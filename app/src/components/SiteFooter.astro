---
import { menus } from "../data";

const links = menus.footer;
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="footer-grid">
		<div>
			<img src="/logo/raylf-logo-white.png" alt="RAYLF" style="height:84px;width:auto;margin-bottom:18px" />
			<p style="font-size:14px;line-height:1.7;max-width:360px">
				RAYLF&rsquo;s mission is to redefine centuries of the rich resilient spirit
				of African Kingdoms which embodies many defining principles of its identity.
			</p>
		</div>
		<div>
			<h5>Important Links</h5>
			<ul class="footer-links">
				{
					links.map((l: any) => (
						<li>
							<i class="fa-solid fa-chevron-right" />
							<a href={l.url}>{l.label}</a>
						</li>
					))
				}
			</ul>
		</div>
		<div>
			<h5>Contact</h5>
			<a href="mailto:info@royalafrican.foundation" style="color:var(--gold-200);font-size:14px">
				info@royalafrican.foundation
			</a>
			<div style="margin-top:22px">
				<div class="social-icons">
					<a href="#" aria-label="facebook"><i class="fa-brands fa-facebook-f" /></a>
					<a href="#" aria-label="x"><i class="fa-brands fa-x-twitter" /></a>
					<a href="#" aria-label="instagram"><i class="fa-brands fa-instagram" /></a>
				</div>
			</div>
		</div>
	</div>
	<div class="footer-bottom">
		<span>&copy; {year} Royal African Young Leadership Forum</span>
		<button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">
			<i class="fa-solid fa-sun" />
		</button>
	</div>
</footer>

<script>
	function initThemeToggle() {
		const toggle = document.getElementById("theme-toggle") as HTMLButtonElement | null;
		if (!toggle) return;

		const setIcon = () => {
			const theme = document.documentElement.getAttribute("data-theme");
			toggle.innerHTML =
				theme === "dark"
					? '<i class="fa-solid fa-sun"></i>'
					: '<i class="fa-solid fa-moon"></i>';
		};
		setIcon();

		toggle.addEventListener("click", () => {
			const next =
				document.documentElement.getAttribute("data-theme") === "dark" ? "light" : "dark";
			document.documentElement.setAttribute("data-theme", next);
			try {
				localStorage.setItem("raylf-theme", next);
			} catch {}
			setIcon();
		});
	}
	initThemeToggle();
	document.addEventListener("astro:page-load", initThemeToggle);
</script>
